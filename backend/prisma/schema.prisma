generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum GlobalRole {
  ADMIN
  USER
}

enum ProjectRole {
  PROJECT_MANAGER
  TEAM_MEMBER
  VIEWER
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  ESCALATED
  DONE
  CLOSED
}

enum EscalationType {
  MANUAL
  SLA_BREACH
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  password           String
  name               String
  globalRole         GlobalRole      @default(USER)
  isActive           Boolean         @default(true)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  projectMemberships ProjectMember[]
  createdTasks       Task[]          @relation("CreatedTasks")
  assignedTasks      Task[]          @relation("AssignedTasks")
  comments           Comment[]
  activityLogs       ActivityLog[]
  notifications      Notification[]
  requestedTickets    Task[]       @relation("RequestedTickets")
  escalationsMade     Escalation[] @relation("EscalatedBy")
  escalationsReceived Escalation[] @relation("EscalatedTo")
  escalationsFrom     Escalation[] @relation("EscalatedFrom")
}

model Project {
  id           String          @id @default(uuid())
  name         String
  description  String?
  isArchived   Boolean         @default(false)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  members      ProjectMember[]
  tasks        Task[]
  activityLogs ActivityLog[]
  slaPolicies         SlaPolicy[]
  kpiTargets          KpiTarget[]
}

model ProjectMember {
  id        String      @id @default(uuid())
  projectId String
  userId    String
  role      ProjectRole
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
}

model Task {
  id               String         @id @default(uuid())
  ticketNumber     Int            @unique @default(autoincrement())
  projectId        String
  title            String
  description      String?
  status           TaskStatus     @default(TODO)
  priority         TaskPriority   @default(MEDIUM)
  version          Int            @default(1)
  createdById      String
  requesterId      String?
  assigneeId       String?
  category         String?
  dueDate          DateTime?
  
  // KPM: SLA deadlines + lifecycle timestamps
  slaResponseDueAt DateTime?
  slaResolveDueAt  DateTime?
  firstResponseAt  DateTime?
  resolvedAt       DateTime?
  closedAt         DateTime?
  slaBreachedAt    DateTime?
  escalationLevel  Int            @default(1)
  reopenCount      Int            @default(0)

  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy        User           @relation("CreatedTasks", fields: [createdById], references: [id], onDelete: Restrict)
  requester        User?          @relation("RequestedTickets", fields: [requesterId], references: [id], onDelete: SetNull)
  assignee         User?          @relation("AssignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  
  comments         Comment[]
  escalations      Escalation[]

  @@index([projectId, status])
  @@index([assigneeId])
  @@index([slaResolveDueAt])
  @@index([resolvedAt])
}

model Comment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String
  isInternal       Boolean        @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String?
  projectId  String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, createdAt])

}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, isRead])
}

model SlaPolicy {
  id             String       @id @default(uuid())
  projectId      String?      // null = global default
  priority       TaskPriority
  responseMinutes Int
  resolveMinutes Int

  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, priority])
}

model Escalation {
  id             String         @id @default(uuid())
  taskId         String
  fromLevel      Int
  toLevel        Int
  type           EscalationType
  reason         String
  escalatedById  String?        // null = automated system worker
  escalatedToId  String?
  fromAssigneeId String?        // the agent who owned the ticket before it was escalated
  createdAt      DateTime       @default(now())

  task           Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  escalatedBy    User?          @relation("EscalatedBy", fields: [escalatedById], references: [id], onDelete: SetNull)
  escalatedTo    User?          @relation("EscalatedTo", fields: [escalatedToId], references: [id], onDelete: SetNull)
  fromAssignee   User?          @relation("EscalatedFrom", fields: [fromAssigneeId], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([createdAt])
  @@index([fromAssigneeId])
}

model KpiTarget {
  id             String       @id @default(uuid())
  projectId      String?      // null = global default
  metric         String       // SLA_COMPLIANCE, AVG_RESOLUTION_HOURS, etc.
  target         Float
  weight         Float        @default(1)
  higherIsBetter Boolean      @default(true)

  project        Project?     @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, metric])
}
