# General
NODE_ENV=development

# Backend Settings
PORT=4000
JWT_SECRET=supersecretjwtkey_change_me_in_production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000

# Database Settings (Docker Postgres)
POSTGRES_USER=neostats_user
POSTGRES_PASSWORD=neostats_password
POSTGRES_DB=neostats_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://neostats_user:neostats_password@localhost:5432/neostats_db?schema=public"

# Frontend Settings
NEXT_PUBLIC_API_URL=http://localhost:4000/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
